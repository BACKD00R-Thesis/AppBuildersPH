# Brainrot Study environment contract.
# Copy to .env and fill in values for your machine. Never commit .env.
# Every variable the project reads must be listed here (names only, no values).
# Blank means "use the default"; defaults are listed in docs/development.md.

# --- Local API (FastAPI) ---
API_HOST=
API_PORT=
# Shared secret so other devices on your network can't use your backend.
API_PAIRING_TOKEN=
# Comma-separated origins allowed by CORS (only needed for Expo web).
API_CORS_ORIGINS=

# --- Storage ---
# Uploaded PDFs, per-line audio, captions, and rendered videos.
DATA_DIR=
# Downloaded TTS and Whisper model files.
MODELS_DIR=
# SQLite connection string, e.g. sqlite:///./data/brainrot.db
DATABASE_URL=

# --- LLM (Ollama) ---
OLLAMA_HOST=
# llama3.2:3b or qwen2.5:3b
OLLAMA_MODEL=
OLLAMA_TIMEOUT_S=

# --- Text-to-speech ---
# kokoro, piper, or dummy (placeholder beeps; no models needed, for development)
TTS_ENGINE=
KOKORO_VOICE_A=
KOKORO_VOICE_B=
PIPER_VOICE_A=
PIPER_VOICE_B=

# --- Word alignment (faster-whisper) ---
# base or small
WHISPER_MODEL=
# cpu or cuda
WHISPER_DEVICE=
# int8 or float16
WHISPER_COMPUTE_TYPE=

# --- Video rendering ---
FFMPEG_PATH=
RENDER_WIDTH=
RENDER_HEIGHT=
RENDER_FPS=

# --- Mobile app (Expo; EXPO_PUBLIC_* values are bundled into the app) ---
# Expo reads these from apps/mobile/.env, not this file. Both are optional:
# the address and token can also be entered in the app's Server screen.
# Backend URL as seen from the phone, e.g. http://192.168.1.23:8000 (not localhost)
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_API_PAIRING_TOKEN=
