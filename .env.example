# Brainrot Study environment contract.
# Copy to .env and fill in values for your machine. Never commit .env.
# Every variable the project reads must be listed here (names only, no values).
# Blank means "use the default"; defaults are listed in docs/development.md.

# --- Server (FastAPI: API under /api, web app at /) ---
API_HOST=
API_PORT=
# Shared secret so other devices on your network can't use the engine.
# Open the app once as http://<laptop>:8000/?token=<token> on each device.
API_PAIRING_TOKEN=
# Comma-separated origins allowed by CORS. Only needed if the web app is served from another origin.
API_CORS_ORIGINS=
# Your name for the greeting ("Kumusta, <name>!").
USER_NAME=

# --- Storage ---
# Uploaded PDFs and notes, per-line audio, captions, and rendered videos.
DATA_DIR=
# Downloaded TTS and Whisper model files.
MODELS_DIR=
# SQLite connection string, e.g. sqlite:///./data/brainrot.db
DATABASE_URL=
# The built web app (apps/web/dist). Served at / when it exists.
WEB_DIST_DIR=

# --- LLM (Ollama) ---
OLLAMA_HOST=
# llama3.2:3b or qwen2.5:3b
OLLAMA_MODEL=
OLLAMA_TIMEOUT_S=

# --- Text-to-speech ---
# kokoro, piper, or dummy (placeholder beeps; no models needed, for development)
TTS_ENGINE=
KOKORO_VOICE_A=
KOKORO_VOICE_B=
PIPER_VOICE_A=
PIPER_VOICE_B=

# --- Word alignment (faster-whisper) ---
# base or small
WHISPER_MODEL=
# cpu or cuda
WHISPER_DEVICE=
# int8 or float16
WHISPER_COMPUTE_TYPE=

# --- Video rendering ---
FFMPEG_PATH=
RENDER_WIDTH=
RENDER_HEIGHT=
RENDER_FPS=

# --- Web app dev server (apps/web: npm run dev) ---
# Where the dev server proxies /api. Defaults to http://localhost:8000.
ENGINE_URL=
